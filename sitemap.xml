---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ "/" | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  <url><loc>{{ "/inputs/" | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  {%- assign releases = site.outputs | sort: "date" | reverse %}
  {%- for r in releases %}
  <url><loc>{{ r.url | absolute_url }}</loc></url>
  {%- endfor %}
</urlset>
